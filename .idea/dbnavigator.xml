    <connection id="ed074bed-f055-4d0b-8f0b-df6d9986edea">
      <console name="Connection" type="STANDARD" schema="" session="Main"><![CDATA[-- 사용자 테이블 (users)
CREATE TABLE users (
    user_id INT AUTO_INCREMENT PRIMARY KEY,  -- 사용자 ID
    username VARCHAR(255) NOT NULL,  -- 사용자 이름
    password VARCHAR(255) NOT NULL,  -- 비밀번호
    phone_number VARCHAR(20),  -- 전화번호
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP  -- 생성일
);

-- 유저 로그인 기록 테이블 (user_login)
CREATE TABLE user_login (
    login_id INT AUTO_INCREMENT PRIMARY KEY,  -- 로그인 기록 ID
    user_id INT NOT NULL,  -- 사용자 ID (외래키)
    login_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP,  -- 로그인 시간
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE  -- 외래키 (사용자 ID)
);

-- 영수증 테이블 (receipts)
CREATE TABLE receipts (
    receipt_id INT AUTO_INCREMENT PRIMARY KEY,  -- 영수증 ID
    user_id INT NOT NULL,  -- 사용자 ID (외래키)
    scanned_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,  -- 스캔 시간
    status ENUM('pending', 'completed', 'failed') NOT NULL,  -- 영수증 상태
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE  -- 외래키 (사용자 ID)
);

-- 영수증 품목 테이블 (receipt_items)
CREATE TABLE receipt_items (
    item_id INT AUTO_INCREMENT PRIMARY KEY,  -- 품목 ID
    receipt_id INT NOT NULL,  -- 영수증 ID (외래키)
    name VARCHAR(255) NOT NULL,  -- 품목 이름
    category VARCHAR(255) NOT NULL,  -- 품목 카테고리
    FOREIGN KEY (receipt_id) REFERENCES receipts(receipt_id) ON DELETE CASCADE  -- 외래키 (영수증 ID)
);

-- 소비 분석 테이블 (analysis)
CREATE TABLE analysis (
    analysis_id INT AUTO_INCREMENT PRIMARY KEY,  -- 분석 ID
    user_id INT NOT NULL,  -- 사용자 ID (외래키)
    category VARCHAR(255) NOT NULL,  -- 카테고리 (예: Dairy, Produce 등)
    total_items INT NOT NULL,  -- 총 아이템 수
    consumed_items INT NOT NULL,  -- 소비된 아이템 수
    wasted_items INT NOT NULL,  -- 버린 아이템 수
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,  -- 생성일
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE  -- 외래키 (사용자 ID)
);

-- 장바구니 테이블 (cart)
CREATE TABLE cart (
    cart_item_id INT AUTO_INCREMENT PRIMARY KEY,  -- 장바구니 품목 ID
    user_id INT NOT NULL,  -- 사용자 ID (외래키)
    name VARCHAR(255) NOT NULL,  -- 품목 이름
    category VARCHAR(255) NOT NULL,  -- 품목 카테고리
    quantity INT NOT NULL,  -- 품목 수량
    added_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,  -- 추가 시간
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE  -- 외래키 (사용자 ID)
);]]></console>
